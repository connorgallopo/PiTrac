{
  "name": "pitrac-web-ui",
  "version": "1.0.0",
  "description": "Modern web interface for PiTrac Golf Launch Monitor System",
  "main": "server.py",
  "scripts": {
    "dev": "python main.py",
    "test": "pytest",
    "lint": "flake8 .",
    "format": "black .",
    "build-css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch"
  },
  "keywords": [
    "pitrac",
    "golf",
    "launch-monitor",
    "flyonui",
    "tailwindcss"
  ],
  "author": "PiTrac Team",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "flyonui": "^1.3.1",
    "heroicons": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.18",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jamespilgrim/PiTrac.git"
  },
  "bugs": {
    "url": "https://github.com/jamespilgrim/PiTrac/issues"
  },
  "homepage": "https://github.com/jamespilgrim/PiTrac#readme"
