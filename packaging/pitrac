		"config restore") pitrac_config_restore_command ;;
		"config migrate") pitrac_config_migrate_command ;;
		"config source") pitrac_config_source_command ;;
		"camera") pitrac_camera_command ;;
		"camera list") pitrac_camera_list_command ;;
		"camera test") pitrac_camera_test_command ;;
