parse_requirements() {

	while [[ $# -gt 0 ]]; do
		key="$1"
		case "$key" in
			--version)
				version_command
				exit
				;;

			--help | -h)
				long_usage=yes
				pitrac_usage
				exit
				;;

			--config | -c)

				if [[ -n ${2+x} ]]; then
					args['--config']="$2"
					shift
					shift
				else
					printf "%s\n" "--config requires an argument: --config, -c PATH" >&2
					exit 1
				fi
				;;

			--verbose | -v)

				args['--verbose']=1
				shift
				;;

			--debug)

				args['--debug']=1
				shift
				;;

			*)
				break
				;;

		esac
	done

	export PITRAC_CONFIG="${PITRAC_CONFIG:-/etc/pitrac/pitrac.yaml}"
	export PITRAC_HOME="${PITRAC_HOME:-${HOME}/.pitrac}"

	env_var_names+=("PITRAC_CONFIG")
	env_var_names+=("PITRAC_HOME")

	missing_deps=

	if ! command -v bash >/dev/null 2>&1; then
		printf "missing dependency: bash\n" >&2
		missing_deps=1
	else
		deps['bash']="$(command -v bash | head -n1)"
	fi

	if ! command -v grep >/dev/null 2>&1; then
		printf "missing dependency: grep\n" >&2
		missing_deps=1
	else
		deps['grep']="$(command -v grep | head -n1)"
	fi

	if ! command -v sed >/dev/null 2>&1; then
		printf "missing dependency: sed\n" >&2
		missing_deps=1
	else
		deps['sed']="$(command -v sed | head -n1)"
	fi

	if [[ -n $missing_deps ]]; then
		exit 1
	fi

	action=${1:-}

	case $action in
		-*) ;;

		run)
			action="run"
			shift
			pitrac_run_parse_requirements "$@"
			shift $#
			;;

		stop)
			action="stop"
			shift
			pitrac_stop_parse_requirements "$@"
			shift $#
			;;

		status)
			action="status"
			shift
			pitrac_status_parse_requirements "$@"
			shift $#
			;;

		setup)
			action="setup"
			shift
			pitrac_setup_parse_requirements "$@"
			shift $#
			;;

		config | cfg)
			action="config"
			shift
			pitrac_config_parse_requirements "$@"
			shift $#
			;;

		camera | cam)
			action="camera"
			shift
			pitrac_camera_parse_requirements "$@"
			shift $#
			;;

		test)
			action="test"
			shift
			pitrac_test_parse_requirements "$@"
			shift $#
			;;

		calibrate | cal)
			action="calibrate"
			shift
			pitrac_calibrate_parse_requirements "$@"
			shift $#
			;;

		service | svc)
			action="service"
			shift
			pitrac_service_parse_requirements "$@"
			shift $#
			;;

		tomee)
			action="tomee"
			shift
			pitrac_tomee_parse_requirements "$@"
			shift $#
			;;

		activemq | amq)
			action="activemq"
			shift
			pitrac_activemq_parse_requirements "$@"
			shift $#
			;;

		logs)
			action="logs"
			shift
			pitrac_logs_parse_requirements "$@"
			shift $#
			;;

		boot)
			action="boot"
			shift
			pitrac_boot_parse_requirements "$@"
			shift $#
			;;

		version)
			action="version"
			shift
			pitrac_version_parse_requirements "$@"
			shift $#
			;;

		"")
			pitrac_usage >&2
			exit 1
			;;

		*)
			printf "invalid command: %s\n" "$action" >&2
			exit 1
			;;

	esac

	while [[ $# -gt 0 ]]; do
		key="$1"
		case "$key" in

			-?*)
				printf "invalid option: %s\n" "$key" >&2
				exit 1
				;;

			*)

				printf "invalid argument: %s\n" "$key" >&2
				exit 1

				;;

		esac
	done

}

pitrac_run_parse_requirements() {

	while [[ $# -gt 0 ]]; do
		key="$1"
		case "$key" in
			--help | -h)
				long_usage=yes
				pitrac_run_usage
				exit
				;;

			*)
				break
				;;

		esac
	done

	action="run"

	while [[ $# -gt 0 ]]; do
		key="$1"
		case "$key" in

			--foreground | -f)

				args['--foreground']=1
				shift
				;;

			--system-mode)

				if [[ -n ${2+x} ]]; then
					args['--system-mode']="$2"
					shift
					shift
				else
					printf "%s\n" "--system-mode requires an argument: --system-mode MODE" >&2
					exit 1
				fi
				;;

			--msg-broker-address)

				if [[ -n ${2+x} ]]; then
					args['--msg-broker-address']="$2"
					shift
					shift
				else
					printf "%s\n" "--msg-broker-address requires an argument: --msg-broker-address ADDRESS" >&2
					exit 1
				fi
				;;

			--base-image-logging-dir)

				if [[ -n ${2+x} ]]; then
					args['--base-image-logging-dir']="$2"
					shift
					shift
				else
					printf "%s\n" "--base-image-logging-dir requires an argument: --base-image-logging-dir DIR" >&2
					exit 1
				fi
				;;

			--web-server-share-dir)

				if [[ -n ${2+x} ]]; then
					args['--web-server-share-dir']="$2"
					shift
					shift
				else
					printf "%s\n" "--web-server-share-dir requires an argument: --web-server-share-dir DIR" >&2
					exit 1
				fi
				;;

			--e6-host-address)

				if [[ -n ${2+x} ]]; then
					args['--e6-host-address']="$2"
					shift
					shift
				else
					printf "%s\n" "--e6-host-address requires an argument: --e6-host-address HOST" >&2
					exit 1
				fi
				;;

			--gspro-host-address)

				if [[ -n ${2+x} ]]; then
					args['--gspro-host-address']="$2"
					shift
					shift
				else
					printf "%s\n" "--gspro-host-address requires an argument: --gspro-host-address HOST" >&2
					exit 1
				fi
				;;

			-?*)
				printf "invalid option: %s\n" "$key" >&2
				exit 1
				;;

			*)

				printf "invalid argument: %s\n" "$key" >&2
				exit 1

				;;

		esac
	done

	if [[ ${args['--system-mode']:-} ]] && [[ ! ${args['--system-mode']:-} =~ ^(camera1|camera2)$ ]]; then
		printf "%s\n" "--system-mode must be one of: camera1, camera2" >&2
		exit 1
	fi

}

